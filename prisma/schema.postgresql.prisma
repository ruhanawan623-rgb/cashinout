datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CASHIER
  ACCOUNTANT
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum TransactionType {
  CASH_IN
  CASH_OUT
}

enum PaymentMode {
  CASH
  CARD
  UPI
  BANK_TRANSFER
}

enum DosageForm {
  TABLET
  CAPSULE
  SYRUP
  INJECTION
  OINTMENT
  DROPS
  MEDICAL_DEVICE
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          Role            @default(CASHIER)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sessions      CashSession[]
  transactions  CashTransaction[] @relation("CreatedTransactions")
  voidedTxns    CashTransaction[] @relation("VoidedTransactions")
  sales         Sale[]

  @@map("users")
}

model CashSession {
  id                     String         @id @default(cuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id])
  openingBalance         Decimal        @db.Decimal(12, 2)
  actualClosingBalance   Decimal?       @db.Decimal(12, 2)
  expectedClosingBalance Decimal?       @db.Decimal(12, 2)
  difference             Decimal?       @db.Decimal(12, 2)
  status                 SessionStatus  @default(OPEN)
  openedAt               DateTime       @default(now())
  closedAt               DateTime?
  notes                  String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  transactions           CashTransaction[]
  sales                  Sale[]

  @@map("cash_sessions")
}

model Category {
  id           String          @id @default(cuid())
  name         String
  type         TransactionType
  description  String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  transactions CashTransaction[]

  @@unique([name, type])
  @@map("categories")
}

model CashTransaction {
  id           String          @id @default(cuid())
  sessionId    String?
  session      CashSession?    @relation(fields: [sessionId], references: [id])
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  categoryId   String
  category     Category        @relation(fields: [categoryId], references: [id])
  paymentMode  PaymentMode     @default(CASH)
  referenceNo  String?
  note         String?

  // Financial link to POS Billing
  saleId       String?         @unique
  sale         Sale?           @relation(fields: [saleId], references: [id])

  // Immutability & Void Audit
  isVoided     Boolean         @default(false)
  voidReason   String?
  voidedById   String?
  voidedBy     User?           @relation("VoidedTransactions", fields: [voidedById], references: [id])
  voidedAt     DateTime?

  createdById  String
  createdBy    User            @relation("CreatedTransactions", fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([createdAt])
  @@index([type])
  @@index([paymentMode])
  @@map("cash_transactions")
}

// ==========================================
// MEDICAL STORE POS & INVENTORY EXTENSIONS
// ==========================================

model Supplier {
  id            String          @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  balanceDue    Decimal         @default(0) @db.Decimal(12, 2)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  batches       Batch[]

  @@map("suppliers")
}

model Product {
  id                   String      @id @default(cuid())
  brandName            String
  genericName          String?
  dosageForm           DosageForm  @default(TABLET)
  strength             String?
  manufacturer         String?
  sku                  String?     @unique
  barcode              String?     @unique
  unit                 String      @default("Strip")
  minStockLevel        Int         @default(10)
  requiresPrescription Boolean     @default(false)
  isActive             Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  batches              Batch[]
  saleItems            SaleItem[]

  @@index([brandName])
  @@index([genericName])
  @@map("products")
}

model Batch {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber     String
  expiryDate      DateTime
  purchasePrice   Decimal     @db.Decimal(10, 2)
  salePrice       Decimal     @db.Decimal(10, 2)
  quantityInStock Int         @default(0)
  supplierId      String?
  supplier        Supplier?   @relation(fields: [supplierId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  saleItems       SaleItem[]

  @@unique([productId, batchNumber])
  @@index([expiryDate])
  @@map("batches")
}

model Customer {
  id           String      @id @default(cuid())
  name         String
  phone        String?     @unique
  doctorName   String?
  address      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  sales        Sale[]

  @@map("customers")
}

model Sale {
  id              String           @id @default(cuid())
  invoiceNumber   String           @unique
  sessionId       String?
  session         CashSession?     @relation(fields: [sessionId], references: [id])
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  
  subtotal        Decimal          @default(0) @db.Decimal(12, 2)
  discount        Decimal          @default(0) @db.Decimal(12, 2)
  tax             Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @default(0) @db.Decimal(12, 2)
  
  paymentMode     PaymentMode      @default(CASH)
  status          SaleStatus       @default(COMPLETED)

  // Link to Cash Ledger
  cashTransaction CashTransaction?

  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           SaleItem[]

  @@index([createdAt])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id          String    @id @default(cuid())
  saleId      String
  sale        Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  batchId     String?
  batch       Batch?    @relation(fields: [batchId], references: [id])
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  subtotal    Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  @@map("sale_items")
}
